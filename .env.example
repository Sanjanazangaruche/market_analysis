# ========================================================
# AI NSE/BSE Breakout Stock Scanner Configuration
# ========================================================

# OpenAI API Key (Optional: Can also be configured directly via the UI Settings page)
# If left empty, the application seamlessly runs an intelligent rule-based quantitative reasoning engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Market Data Provider
# Options: 'yfinance' (Live Yahoo Finance for NSE .NS and BSE .BO) or 'mock' (Offline Simulator)
DEFAULT_DATA_PROVIDER=yfinance

# Auto-Scanner Default Settings
DEFAULT_SCAN_INTERVAL_MINUTES=5
AUTO_SCAN_ENABLED=false
DEFAULT_TIMEFRAME=15m

# Alert Qualification Thresholds
MIN_ALERT_SCORE=70
MIN_ALERT_CONFIDENCE=70
MIN_RISK_REWARD=1.5

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=false
